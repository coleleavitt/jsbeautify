/target
core.*
*.core
core.[0-9]*

# Stray standalone build artifacts (compiled scratch binaries, not part of the crate)
/rust_out
/test_collision
/invariant_proof

# Sisyphus: exclude regenerable pipeline logs (rebuild via jsbeautify --deobfuscate)
.sisyphus/evidence/*-pipeline.log

# Agent / tooling runtime state (not part of the project)
/.codex/
/.gjc/
/.jfc/
/.mcp.json

# Local CodeQL databases and SARIF results (scripts/codeql.sh)
/.codeql/

# Local-only working directories: old session reports, research notes and
# per-target analysis (see AGENTS.md)
/frontend/
/.research/

# Session exports
/prime-agent-session-*.html

# Ship the agent tooling (.claude/ is often ignored globally), not local settings
!/.claude/
/.claude/settings.local.json
